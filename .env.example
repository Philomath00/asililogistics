# Local demo works without credentials. Set a strong ADMIN_KEY before sharing.
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
# ADMIN_KEY=
# NODE_ENV=production
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Recommended for business-initiated updates outside the 24-hour window:
# WHATSAPP_TEMPLATE_NAME=asili_delivery_update
WHATSAPP_TEMPLATE_LANGUAGE=en
# Local/self-hosted production only (Render supplies RENDER_EXTERNAL_URL):
# ASILI_DOMAIN=deliveries.your-domain.example
# TLS_EMAIL=your-certificate-contact@example.com
# DB_PATH=data/asili.sqlite
# Explicit live-test safeguards; do not enable for automated tests:
# ALLOW_LIVE_WHATSAPP_SEND=1
# WHATSAPP_LIVE_MESSAGE_ID=
# WHATSAPP_TEST_RECIPIENT=
